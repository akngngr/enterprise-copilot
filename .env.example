# Database Configuration (Supabase PostgreSQL Session Pooler)
DATABASE_URL=postgresql://postgres.your_project_ref:your_password@aws-0-us-east-1.pooler.supabase.com:5432/postgres

# Primary LLM Engine (Local Ollama)
OLLAMA_BASE_URL=http://localhost:11434
GEN_MODEL=llama3

# Fallback LLM Engine (Google Gemini API)
GEMINI_API_KEY=your_gemini_api_key_here