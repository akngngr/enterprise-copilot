# ------------------------------------------------------------------
# Local development:  cp .env.example .env   then fill in the blanks.
# Container deploys:  set these in your platform's secret store.
#                     Nothing here is baked into the image — .env is
#                     excluded by .dockerignore, so every value must
#                     come from the environment at runtime.
# ------------------------------------------------------------------

# --- Database ---------------------------------------------------------
# Supabase Transaction pooler (port 6543). The Session pooler on 5432
# does not work with pgbouncer in transaction mode for long-lived
# connections. Keep the URL scheme as postgresql:// (psycopg2 default).
DATABASE_URL=postgresql://postgres.your_project_ref:your_password@aws-0-us-east-1.pooler.supabase.com:6543/postgres

# --- Generation engines ------------------------------------------------
# Primary: local Ollama. Used when ENABLE_OLLAMA_PULL=true.
OLLAMA_BASE_URL=http://localhost:11434
GEN_MODEL=llama3
ENABLE_OLLAMA_PULL=true

# Fallback / cloud engine: Google Gemini.
GEMINI_API_KEY=your_gemini_api_key_here

# Generation resilience. The gemini-3.6/3.7/3.8 flash family has been
# observed returning 503 UNAVAILABLE at the same time, so the fallback is
# an ordered CHAIN rather than a sibling alias of the primary. Each model
# gets GEMINI_MAX_ATTEMPTS attempts with exponential backoff before the
# next one is tried.
#   gemini-3.5-flash is deprecated and redirects to 3.6 (the response's
#   model_version confirms it) but is served from a path that stayed
#   healthy through that outage. gemini-3.1-flash-lite is slower but
#   independent.
GEMINI_CHAT_MODEL=gemini-3.6-flash
GEMINI_CHAT_MODEL_FALLBACKS=gemini-flash-latest,gemini-3.5-flash,gemini-3.1-flash-lite
GEMINI_MAX_ATTEMPTS=3
GEMINI_BACKOFF_SECONDS=1.5

# Embedding resilience. Ingest embeds one call per chunk in a tight loop, so
# any document multiplies the chance of a rate limit partway through - and a
# failure at chunk 11 of 12 discards the whole upload. Same treatment as
# generation, which is why both sets of variables exist.
EMBED_MAX_ATTEMPTS=3
EMBED_BACKOFF_SECONDS=1.5

# --- OIDC token verification (FastAPI side) ----------------------------
# OIDC_AUDIENCE MUST equal the Streamlit [auth] client_id: the API
# verifies the ID token that Streamlit forwards, and the token's `aud`
# claim is the client that requested it.
# For Supabase Auth, set OIDC_ALGORITHMS=ES256 — its JWKS publishes an
# ES256 key. Google uses RS256.
OIDC_ISSUER=https://accounts.google.com
OIDC_AUDIENCE=your-client-id.apps.googleusercontent.com
OIDC_JWKS_URL=https://www.googleapis.com/oauth2/v3/certs
OIDC_ALGORITHMS=RS256

# --- Streamlit auth (only for container deploys) ----------------------
# Streamlit reads [auth] ONLY from ~/.streamlit/secrets.toml and has no
# environment-variable equivalent. That file is gitignored and
# .dockerignore excludes .streamlit, so entrypoint.sh generates it from
# these variables at boot. Locally you do NOT need them — just create
# .streamlit/secrets.toml by hand.
# All of STREAMLIT_AUTH_* are required in production; a missing one
# fails the boot loudly instead of starting an app that cannot sign in.
STREAMLIT_AUTH_REDIRECT_URI=https://your-app.onrender.com/oauth2callback
STREAMLIT_AUTH_CLIENT_ID=your-client-id.apps.googleusercontent.com
STREAMLIT_AUTH_CLIENT_SECRET=your-client-secret
# openssl rand -hex 32
STREAMLIT_AUTH_COOKIE_SECRET=replace-with-32-random-bytes
STREAMLIT_AUTH_SERVER_METADATA_URL=https://accounts.google.com/.well-known/openid-configuration
# Streamlit exposes NO tokens by default, so st.user.tokens["id"] raises
# without this. Only "id" and "access" are valid.
STREAMLIT_AUTH_EXPOSE_TOKENS=id

# --- API gateway (used by the Streamlit frontend) ---------------------
# Inside a single container, localhost is correct. Outside loopback the
# frontend refuses to start on a non-HTTPS value.
API_BASE_URL=http://localhost:8000

# --- Limits and migration guards ---------------------------------------
MAX_UPLOAD_BYTES=26214400
MAX_PDF_PAGES=500
MAX_CHUNKS_PER_DOCUMENT=10000
# The initial migration deletes legacy document_chunks rows when the
# owner_id column has to be added. It refuses to run without this set to
# true once real rows exist — see alembic/versions/20260924_user_context.py.
ALLOW_LEGACY_CONTEXT_DELETE=false